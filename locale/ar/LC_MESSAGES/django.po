msgstr "تسجيل صوت إنسان بالغ"

msgid "Synthetic speech"
msgstr "كلام اصطناعي"

msgid "Source to document"
msgstr "مصدر يحتاج إلى توثيق"

msgid "Regional variety or accent notes"
msgstr "ملاحظات عن المنطقة أو اللكنة"

