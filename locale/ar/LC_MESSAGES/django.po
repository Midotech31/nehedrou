msgstr "التعرّض غير مؤكد"

msgid "Finalized"
msgstr "مكتمل"

msgid "French"
msgstr "الفرنسية"

msgid "Imitation"
msgstr "التكرار بعد نموذج"

msgid "Item meaning must be bounded text."
msgstr "يجب أن يكون معنى المفردة نصًا محدود الطول."

msgid "Lexical choice"
msgstr "اختيار معجمي"

msgid "Linguistic review"
msgstr "مراجعة لغوية"

