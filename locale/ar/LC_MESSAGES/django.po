msgid "A current competence declaration for this variety is required."
msgstr "يلزم تصريح سارٍ بالكفاءة في هذا التنوع اللغوي."

msgid "A demonstration remains an unapproved simulation."
msgstr "يبقى العرض التجريبي محاكاة غير معتمدة."

msgid "A finalized observation cannot acquire new occurrences."
msgstr "لا يمكن إضافة مواضع جديدة إلى ملاحظة أُغلقت."

msgid "A practice declaration cannot be dated in the future."
msgstr "لا يمكن تأريخ الممارسة المبلغ عنها في المستقبل."

msgid "A protocol needs one to sixty explicit items."
msgstr "يتطلب البروتوكول من عنصر واحد إلى ستين عنصرًا محددًا."

msgid "A protocol series must retain its spoken variety."
msgstr "يجب أن تحتفظ سلسلة البروتوكولات بتنوعها اللغوي المنطوق."

msgid "A protocol version cannot be repeated in the source file."
msgstr "لا يمكن تكرار إصدار البروتوكول في الملف المصدر."

msgid "A protocol version cannot change its demonstration identity."
msgstr "لا يمكن تغيير صفة العرض التجريبي لإصدار البروتوكول."

msgid "A published protocol cannot return to draft."
msgstr "لا يمكن إعادة البروتوكول المنشور إلى حالة المسودة."

msgid "A scorable response requires an audible expected word and an identifiable target."
msgstr "يتطلب التقييم محاولة مسموعة للكلمة المتوقعة وموضعًا مستهدفًا قابلًا للتحديد."

msgid "A withdrawn protocol cannot start a new observation."
msgstr "لا يمكن بدء ملاحظة جديدة ببروتوكول مسحوب."

msgid "Accepted variants must be a bounded list."
msgstr "يجب أن تكون البدائل المقبولة في قائمة محدودة."

msgid "Administration conditions and version snapshots are immutable."
msgstr "لا يمكن تعديل ظروف التطبيق أو نسخة الإصدار المحفوظة."

msgid "An accepted variant belongs only to the variant rating."
msgstr "يُستخدم البديل المقبول فقط مع تقييم البديل."

msgid "An audible error needs its error type; refusal is unscorable."
msgstr "يجب تحديد نوع الخطأ المسموع؛ الرفض غير قابل للتقييم."

msgid "An exposure cannot occur in the future."
msgstr "لا يمكن تأريخ التعرض للكلمة في المستقبل."

msgid "An unpresented item cannot contain an observed production."
msgstr "لا يمكن تسجيل إنتاج ملاحظ لعنصر لم يُعرض."

msgid "Archived profiles cannot acquire a new clinical goal."
msgstr "لا يمكن إضافة هدف سريري إلى ملف مؤرشف."

msgid "Archived profiles cannot acquire new coaching."
msgstr "لا يمكن إضافة إرشادات جديدة إلى ملف مؤرشف."

msgid "Check familiarity for every protocol item."
msgstr "تحققوا من معرفة الطفل بكل عنصر في البروتوكول."

msgid "Coaching must belong to the child practice."
msgstr "يجب أن تتبع الإرشادات عيادة الطفل."

msgid "Conditions must be bounded text."
msgstr "يجب وصف الظروف بنص محدود الطول."

msgid "Confirm the external evaluation and all item familiarity before real use."
msgstr "أكدوا التقييم الخارجي ومعرفة الطفل بجميع العناصر قبل الاستخدام الفعلي."

msgid "Corrections are append-only."
msgstr "تُضاف التصحيحات إلى السجل دون تعديل ما سبق."

msgid "Create a new protocol version to change frozen content."
msgstr "أنشئوا إصدارًا جديدًا لتعديل محتوى بروتوكول محفوظ."

msgid "Declare the scope of competence for this spoken variety."
msgstr "صرّحوا بنطاق كفاءتكم في هذا التنوع اللغوي المنطوق."

msgid "Define the retained-attempt rule before observing."
msgstr "حددوا قاعدة المحاولة المعتمدة قبل الملاحظة."

msgid "Demonstration protocols cannot be qualified for real use."
msgstr "بروتوكولات العرض التجريبي غير مؤهلة للاستخدام الفعلي."

msgid "Distinguish trained, reserved and uncertain item plans."
msgstr "ميزوا بين عناصر التدريب والعناصر المحجوزة والعناصر ذات التعرض غير المؤكد."

msgid "Document the protocol rights and their evidence."
msgstr "وثقوا حقوق البروتوكول ومستنداتها."

msgid "Document whether the expected word and target were audible."
msgstr "وضحوا إن كانت الكلمة المتوقعة والموضع المستهدف مسموعين."

msgid "Each item needs an id, word, proposed IPA and target definition."
msgstr "يتطلب كل عنصر معرّفًا وكلمة ونسخًا صوتيًا مقترحًا وتعريفًا للموضع المستهدف."

msgid "Each protocol item must be an object."
msgstr "يجب أن يكون لكل عنصر بنية محددة."

msgid "Each variant needs an explicit id and label."
msgstr "يتطلب كل بديل معرّفًا ووصفًا واضحين."

msgid "Error type is reserved for scorable target errors."
msgstr "يخص نوع الخطأ الأخطاء القابلة للتقييم في الموضع المستهدف فقط."

msgid "Exact reviewed image/audio files with rights are missing or changed."
msgstr "ملفات الصور والصوت التي روجعت بحقوقها مفقودة أو تغيرت."

msgid "Expected the original, unapproved conception-1 protocol contract."
msgstr "يلزم ملف التصميم الأصلي conception-1 غير المعتمد."

msgid "Explain a correction; the previous rating is retained."
msgstr "وضحوا سبب التصحيح؛ سيُحفظ التقييم السابق."

msgid "Explain a stopped practice so the professional can respond."
msgstr "وضحوا سبب التوقف لكي يتمكن الأخصائي من تكييف المساعدة."

msgid "Explain an unscorable response, including refusal or interruption."
msgstr "وضحوا سبب تعذر تقييم الإجابة، مثل الرفض أو الانقطاع."

msgid "Exposure history is append-only."
msgstr "لا يمكن إعادة كتابة سجل التعرض للكلمات."

msgid "Finalization requires a professional and date."
msgstr "يتطلب إغلاق الملاحظة أخصائيًا وتاريخًا."

msgid "Finalized observations cannot be rewritten."
msgstr "لا يمكن إعادة كتابة الملاحظات المغلقة."

msgid "Home-practice declarations are append-only."
msgstr "تُضاف تقارير الممارسة المنزلية إلى السجل دون تعديل ما سبق."

msgid "Human item familiarity and linguistic review evidence are missing."
msgstr "تنقص مستندات التحقق البشري من معرفة العناصر ومراجعتها لغويًا."

msgid "Identify the predetermined retained attempt."
msgstr "حددوا المحاولة المعتمدة التي تقررت مسبقًا."

msgid "Identify the target occurrence explicitly."
msgstr "حددوا موضع الصوت المستهدف بوضوح."

msgid "Keep the attempt predetermined by this protocol version."
msgstr "التزموا بالمحاولة المحددة مسبقًا في هذا الإصدار."

msgid "Name a variant documented before the observation."
msgstr "حددوا بديلًا موثقًا قبل الملاحظة."

msgid "Only a finalized observation can be expressly shared."
msgstr "يمكن مشاركة ملخص الملاحظة المغلقة فقط، بقرار صريح."

msgid "Only unapproved, non-normed drafts without supplied media can be imported."
msgstr "يمكن استيراد مسودات غير معتمدة وغير مقننة وبدون وسائط مرفقة فقط."

msgid "Protocol evidence must be an object."
msgstr "يجب تنظيم مستندات البروتوكول في بنية واضحة."

msgid "Protocol item identifiers must be unique."
msgstr "يجب أن تكون معرّفات العناصر فريدة."

msgid "Protocol version identity cannot be changed."
msgstr "لا يمكن تغيير هوية إصدار البروتوكول."

msgid "Publish a new coaching instruction to retain the previous version."
msgstr "أضيفوا إرشادًا جديدًا للحفاظ على النسخة السابقة."

msgid "Rate every planned occurrence, explicitly marking unpresented items."
msgstr "قيّموا كل موضع مقرر وحددوا بوضوح العناصر التي لم تُعرض."

msgid "Rating notes must be bounded text."
msgstr "يجب أن تكون ملاحظات التقييم محدودة الطول."

msgid "Ratings are immutable; append a reasoned correction."
msgstr "تُحفظ التقييمات السابقة؛ أضيفوا تصحيحًا مع بيان السبب."

msgid "Record item familiarity and uncertainty explicitly."
msgstr "وثقوا معرفة الطفل بالعناصر وما لم يتأكد منها."

msgid "Review a submitted protocol version."
msgstr "راجعوا إصدارًا مقدمًا من البروتوكول."

msgid "Review and finalize the observation before sharing a summary."
msgstr "راجعوا الملاحظة وأغلقوها قبل مشاركة الملخص."

msgid "Review decisions are append-only."
msgstr "تُضاف قرارات المراجعة دون استبدال السجل."

msgid "Select a supported human rating and actual elicitation."
msgstr "اختاروا التقييم البشري وطريقة استدعاء الإجابة المستخدمة فعليًا."

msgid "Simulation protocols require demonstration mode and an explicitly fictitious child."
msgstr "تتطلب المحاكاة وضع العرض التجريبي وملف طفل افتراضيًا معلنًا."

msgid "The administration must match its goal, child, practice and variety."
msgstr "يجب أن يتوافق التطبيق مع الهدف والطفل والعيادة والتنوع اللغوي."

msgid "The contract needs explicit draft examples."
msgstr "يتطلب ملف التصميم أمثلة واضحة في حالة المسودة."

msgid "The existing protocol version differs; import an explicit new version instead of overwriting history."
msgstr "يختلف الإصدار الموجود؛ استوردوا إصدارًا جديدًا صريحًا للحفاظ على السجل."

msgid "The exposure must match its source child."
msgstr "يجب أن يطابق التعرض الطفل المرتبط بالممارسة المصدر."

msgid "The exposure variety must be recorded for this child."
msgstr "يجب تسجيل التنوع اللغوي للتعرض في ملف هذا الطفل."

msgid "The goal and child must belong to the same practice."
msgstr "يجب أن يتبع الهدف والطفل العيادة نفسها."

msgid "The item is not part of this frozen protocol."
msgstr "العنصر ليس ضمن نسخة البروتوكول المحفوظة."

msgid "The linked protocol must use the same spoken variety."
msgstr "يجب أن يستخدم البروتوكول المرتبط التنوع اللغوي المنطوق نفسه."

msgid "The occurrence must belong to the frozen protocol."
msgstr "يجب أن يكون الموضع ضمن نسخة البروتوكول المحفوظة."

msgid "The profile is archived; existing observations remain available."
msgstr "الملف مؤرشف؛ تبقى الملاحظات السابقة متاحة."

msgid "The protocol and goal must use the same spoken variety."
msgstr "يجب أن يستخدم البروتوكول والهدف التنوع اللغوي المنطوق نفسه."

msgid "The retained attempt must be defined before administration."
msgstr "يجب تحديد المحاولة المعتمدة قبل التطبيق."

msgid "The return must match its shared coaching instruction."
msgstr "يجب أن يطابق التقرير الإرشادات المشتركة المعنية."

msgid "This administration key was already used with different conditions."
msgstr "استُخدم معرّف التطبيق هذا سابقًا بظروف مختلفة."

msgid "This protocol transition is not allowed."
msgstr "تغيير حالة البروتوكول هذا غير مسموح."

msgid "This return key was already used with different observations."
msgstr "استُخدم معرّف التقرير هذا سابقًا بملاحظات مختلفة."

msgid "Two current, distinct clinical and linguistic human reviewers with declared competence are required."
msgstr "يلزم مراجعان بشريان مختلفان، سريري ولغوي، بكفاءة معلنة وقرارات سارية."

msgid "Two distinct, current human reviews are required."
msgstr "يلزم قرارا مراجعة بشريان مختلفان وساريان."

msgid "Use a spoken variety recorded for this child."
msgstr "استخدموا تنوعًا لغويًا منطوقًا مسجلًا لهذا الطفل."

msgid "Use the documented observation conditions."
msgstr "استخدموا ظروف الملاحظة الموثقة."

msgid "Variant identifiers must be unique and text bounded."
msgstr "يجب أن تكون معرّفات البدائل فريدة ونصوصها محدودة."

msgid "Exact intact rights, familiarity and linguistic evidence is required for this protocol version."
msgstr "يتطلب هذا الإصدار مستندات مطابقة وسليمة للحقوق ومعرفة العناصر والمراجعة اللغوية."

msgid "The protocol target must match the clinical goal target."
msgstr "يجب أن يطابق هدف البروتوكول الهدف السريري."

msgid "Professional observation summary"
msgstr "ملخص الملاحظة المهنية"

msgid "Already assessed by the responsible professional"
msgstr "سبق إجراء التقييم لدى المختص المسؤول"

msgid "Arabic"
msgstr "العربية"

msgid "Audible target omission"
msgstr "حذف مسموع للصوت المستهدف"

msgid "Choose the caregiver instruction language explicitly."
msgstr "حدّد صراحةً لغة الإرشادات الموجّهة للمرافق."

msgid "Clinical review"
msgstr "مراجعة سريرية"

msgid "Distortion"
msgstr "تشويه صوتي"

msgid "Documentation missing"
msgstr "التوثيق مفقود"

msgid "Documented compatible open licence"
msgstr "ترخيص مفتوح متوافق وموثّق"

msgid "Documented occurrence descriptions must be bounded text."
msgstr "يجب أن تكون أوصاف المواضع الموثّقة نصوصًا محدودة الطول."

msgid "Documented occurrence indices must identify distinct phonemic segments."
msgstr "يجب أن تحدّد فهارس المواضع الموثّقة وحدات فونيمية متمايزة."

msgid "Documented occurrences must be a bounded list."
msgstr "يجب أن تكون المواضع الموثّقة قائمة محدودة الطول."

msgid "Documented variant acceptable"
msgstr "بديل موثّق مقبول"

