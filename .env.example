# Copy values to environment; this file is documentation, not auto-loaded.
DJANGO_DEBUG=1
DEMO_MODE=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:8000
# Set private, random values yourself.
DJANGO_SECRET_KEY=
DEMO_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=nehdrou
POSTGRES_USER=nehdrou
POSTGRES_PASSWORD=

# Optional durable demonstration: initialize its separate PostgreSQL database first.
POSTGRES_MIGRATION_HOST=
POSTGRES_SSLMODE=require
DEMO_EPHEMERAL=0
DEMO_SEED_ON_START=1
# Keep 1 until the demonstration database is initialized, then set 0.
NEHEDROU_MEDIA_BACKEND=filesystem
NEHEDROU_MEDIA_ROOT=
NEHEDROU_MEDIA_DURABLE=0
# For s3: all five values below are required; use private, dedicated credentials.
NEHEDROU_S3_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Operator-only backup secret and optional PostgreSQL binary directory.
NEHEDROU_BACKUP_KEY=
NEHEDROU_PG_BIN=

# Mail delivery is unconfigured. Omit EMAIL_BACKEND for automatic safe defaults:
# local DEBUG uses console; non-DEBUG uses DisabledEmailBackend and logs no email body.
# For an operator-authorized HTTPS provider, explicitly select:
# EMAIL_BACKEND=core.email_backends.ResendEmailBackend
RESEND_ENABLED=0
RESEND_API_KEY=
EMAIL_HTTP_CONNECT_TIMEOUT=5
EMAIL_HTTP_READ_TIMEOUT=10
# SMTP alternative: explicit backend and credentials required. Render Free blocks 25/465/587.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=access@nehdrou.example
