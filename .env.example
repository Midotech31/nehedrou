# Copy values to environment; this file is documentation, not auto-loaded.
DJANGO_DEBUG=1
DEMO_MODE=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:8000
# Set private, random values yourself.
DJANGO_SECRET_KEY=
DEMO_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=nehdrou
POSTGRES_USER=nehdrou
POSTGRES_PASSWORD=

# Optional durable demonstration: initialize its separate PostgreSQL database first.
POSTGRES_MIGRATION_HOST=
POSTGRES_SSLMODE=require
DEMO_EPHEMERAL=0
DEMO_SEED_ON_START=1
# Keep 1 until the demonstration database is initialized, then set 0.
NEHEDROU_MEDIA_BACKEND=filesystem
NEHEDROU_MEDIA_ROOT=
NEHEDROU_MEDIA_DURABLE=0
# For s3: all five values below are required; use private, dedicated credentials.
NEHEDROU_S3_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Operator-only backup secret and optional PostgreSQL binary directory.
NEHEDROU_BACKUP_KEY=
NEHEDROU_PG_BIN=
